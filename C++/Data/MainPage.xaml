      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.8">
            <GradientStop Color="#00000000" Offset="0.45"/>
            <GradientStop Color="#C0060405" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <!-- Links, then nodes on top -->
      <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource Template.SkillLink}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Header -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,163,0,0" IsHitTestVisible="False">
        <TextBlock Text="SKILL ENHANCEMENTS" Foreground="{StaticResource Brush.Gold}" FontSize="40"
          HorizontalAlignment="Center">
          <TextBlock.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="22" Color="{StaticResource Color.Gold}" Opacity="0.45"/>
          </TextBlock.Effect>
        </TextBlock>
        <TextBlock Text="ENHANCE YOUR POWER" Foreground="{StaticResource Brush.White}" FontSize="20"
          HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <Rectangle Width="36" Height="1" Fill="{StaticResource Brush.White}" Opacity="0.7" Margin="0,8,0,0"/>
        <TextBlock Text="AVAILABLE MIND SHARDS" Foreground="{StaticResource Brush.White}" FontSize="20"
          HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>

      <!-- Mind shards counter, sits on lattice point (0, -2) = (960, 360) -->
      <Canvas IsHitTestVisible="False">
        <ContentControl Canvas.Left="922" Canvas.Top="318" Content="{Binding}"
          ContentTemplate="{StaticResource Template.Shards}" Focusable="False"/>
      </Canvas>

      <ItemsControl ItemsSource="{Binding Nodes}" ItemTemplate="{StaticResource Template.SkillNode}"
        ItemContainerStyle="{StaticResource Style.NodeContainer}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Hotkeys -->
      <Button Style="{StaticResource Style.HotkeyButton}" Command="{Binding Close}"
        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,942,0,0">
        <StackPanel>
          <TextBlock Text="ESC" Style="{StaticResource Style.HotkeyKey}"/>
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Style.HotkeyAction}">
                <Setter Property="Text" Value="CLOSE"/>
                <Style.Triggers>
                  <!-- With a pending selection, ESC discards it instead of closing -->
                  <DataTrigger Binding="{Binding HasPending}" Value="True">
                    <Setter Property="Text" Value="CANCEL"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Button>
      <Button Command="{Binding Apply}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1693,942,0,0">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource Style.HotkeyButton}">
            <Setter Property="Opacity" Value="0.45"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasPending}" Value="True">
                <Setter Property="Opacity" Value="1"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <StackPanel>
          <TextBlock Text="ENTER" Style="{StaticResource Style.HotkeyKey}"/>
          <TextBlock Text="APPLY" Style="{StaticResource Style.HotkeyAction}"/>
        </StackPanel>
      </Button>
    </Grid>
  </Viewbox>
</Page>
