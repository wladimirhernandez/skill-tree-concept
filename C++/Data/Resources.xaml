<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================================================================================== -->
  <!-- Palette (from the concept sheet: #13141B, #D6281C, #FFC582, #FFFFFF)                   -->
  <!-- ===================================================================================== -->
  <Color x:Key="Color.Ink">#FF13141B</Color>
  <Color x:Key="Color.Red">#FFD6281C</Color>
  <Color x:Key="Color.Gold">#FFFFC582</Color>
  <Color x:Key="Color.White">#FFFFFFFF</Color>

  <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}"/>
  <SolidColorBrush x:Key="Brush.Red" Color="{StaticResource Color.Red}"/>
  <SolidColorBrush x:Key="Brush.Gold" Color="{StaticResource Color.Gold}"/>
  <SolidColorBrush x:Key="Brush.White" Color="{StaticResource Color.White}"/>
  <SolidColorBrush x:Key="Brush.Grid" Color="#FF3B1513"/>

  <!-- Soft halos (cheap replacement for blurred copies) -->
  <RadialGradientBrush x:Key="Brush.GoldGlow">
    <GradientStop Color="#C0FFC582" Offset="0.35"/>
    <GradientStop Color="#40FFA040" Offset="0.62"/>
    <GradientStop Color="#00FF8030" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="Brush.RedGlow">
    <GradientStop Color="#A0D6281C" Offset="0.35"/>
    <GradientStop Color="#30D6281C" Offset="0.65"/>
    <GradientStop Color="#00D6281C" Offset="1"/>
  </RadialGradientBrush>

  <FontFamily x:Key="Font.Main">Fonts/#Alegreya</FontFamily>

  <!-- ===================================================================================== -->
  <!-- Hexagons (pointy-top), absolute coordinates inside a 140x140 node box, centre 70,70    -->
  <!-- ===================================================================================== -->
  <!-- R = 68 : hover ring -->
  <Geometry x:Key="Geo.HexHover">M70,2 L128.89,36 L128.89,104 L70,138 L11.11,104 L11.11,36 Z</Geometry>
  <!-- R = 60 : outer frame / selected border / burst -->
  <Geometry x:Key="Geo.HexOuter">M70,10 L121.96,40 L121.96,100 L70,130 L18.04,100 L18.04,40 Z</Geometry>
  <!-- R = 52 : node body -->
  <Geometry x:Key="Geo.HexBody">M70,18 L115.03,44 L115.03,96 L70,122 L24.97,96 L24.97,44 Z</Geometry>
  <!-- R = 47 : inner hairline -->
  <Geometry x:Key="Geo.HexInner">M70,23 L110.70,46.5 L110.70,93.5 L70,117 L29.30,93.5 L29.30,46.5 Z</Geometry>
  <!-- Small ticks on the outer vertices ("UNLOCKED" state in the sheet) -->
  <Geometry x:Key="Geo.HexTicks">M70,10 L70,3 M121.96,40 L128.02,36.5 M121.96,100 L128.02,103.5 M70,130 L70,137 M18.04,100 L11.98,103.5 M18.04,40 L11.98,36.5</Geometry>

  <!-- ===================================================================================== -->
  <!-- Skill glyphs, 24x24 box. Original shapes inspired by the concept's style.            -->
  <!-- ===================================================================================== -->
  <Geometry x:Key="Icon.Layers">M12,2 L21,7 L12,12 L3,7 Z M3,10.5 L12,15.5 L21,10.5 L21,13 L12,18 L3,13 Z M3,16 L12,21 L21,16 L21,18.5 L12,23.5 L3,18.5 Z</Geometry>
  <Geometry x:Key="Icon.Spiral">F1 M12,2 A10,10 0 1 0 22,12 L18.5,12 A6.5,6.5 0 1 1 12,5.5 Z M12,8 A4,4 0 1 0 16,12 L13.6,12 A1.6,1.6 0 1 1 12,10.4 Z</Geometry>
  <Geometry x:Key="Icon.Peak">M12,2 L22.5,21.5 L16.5,21.5 L12,12.5 L7.5,21.5 L1.5,21.5 Z M10.2,16.5 L13.8,16.5 L15,19 L9,19 Z</Geometry>
  <Geometry x:Key="Icon.Burst">M12,1 L13.6,6.6 L12,8.2 L10.4,6.6 Z M12,23 L13.6,17.4 L12,15.8 L10.4,17.4 Z M1,12 L6.6,10.4 L8.2,12 L6.6,13.6 Z M23,12 L17.4,10.4 L15.8,12 L17.4,13.6 Z M12,9.2 L14.8,12 L12,14.8 L9.2,12 Z M4.2,4.2 L8.8,7.2 L7.2,8.8 Z M19.8,4.2 L16.8,8.8 L15.2,7.2 Z M4.2,19.8 L7.2,15.2 L8.8,16.8 Z M19.8,19.8 L15.2,16.8 L16.8,15.2 Z</Geometry>
  <Geometry x:Key="Icon.Funnel">M2,3 L22,3 L20.8,6 L3.2,6 Z M4.5,8.5 L19.5,8.5 L18.3,11.5 L5.7,11.5 Z M7,14 L17,14 L15.8,17 L8.2,17 Z M9.5,19.5 L14.5,19.5 L12,23 Z</Geometry>
  <Geometry x:Key="Icon.Rune">M3,5 L7.5,5 L15.5,16 L15.5,5 L20,5 L20,22 L15.5,22 L7.5,11 L7.5,22 L3,22 Z M21,0.8 A1.9,1.9 0 1 1 20.99,0.8 Z</Geometry>
  <Geometry x:Key="Icon.Ring">F1 M12,2 A9.5,9.5 0 1 1 11.99,2 Z M12,6.5 A5,5 0 1 0 12.01,6.5 Z M13.5,13 L16.5,13 L22,21.5 L18.5,21.5 Z</Geometry>
  <Geometry x:Key="Icon.Tri">M12,1.5 L16.5,9.5 L7.5,9.5 Z M2,21.5 L6.5,13.2 L11,21 Z M22,21.5 L13,21 L17.5,13.2 Z M12,12 L13.4,14.4 L10.6,14.4 Z</Geometry>
  <Geometry x:Key="Icon.Slash">M1.5,4 L6.5,4 L12,15 L14,11 L10.5,4 L15.5,4 L17.5,8 L19.5,4 L22.5,4 L12,23 Z</Geometry>

  <!-- Mind shard (currency) -->
  <Geometry x:Key="Icon.Shard">F1 M12,1 C15.5,6.5 19.5,10.5 19.5,15 A7.5,7.5 0 0 1 4.5,15 C4.5,10.5 8.5,6.5 12,1 Z M12,8 C10,11 8.3,13 8.3,15.3 A3.7,3.7 0 0 0 15.7,15.3 C15.7,13 14,11 12,8 Z</Geometry>

  <!-- Picks the glyph from SkillNode.Icon -->
  <Style x:Key="Style.SkillIcon" TargetType="Path">
    <Setter Property="Stretch" Value="Uniform"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Icon}" Value="Layers"><Setter Property="Data" Value="{StaticResource Icon.Layers}"/></DataTrigger>
      <DataTrigger Binding="{Binding Icon}" Value="Spiral"><Setter Property="Data" Value="{StaticResource Icon.Spiral}"/></DataTrigger>
      <DataTrigger Binding="{Binding Icon}" Value="Peak"><Setter Property="Data" Value="{StaticResource Icon.Peak}"/></DataTrigger>
      <DataTrigger Binding="{Binding Icon}" Value="Burst"><Setter Property="Data" Value="{StaticResource Icon.Burst}"/></DataTrigger>
      <DataTrigger Binding="{Binding Icon}" Value="Funnel"><Setter Property="Data" Value="{StaticResource Icon.Funnel}"/></DataTrigger>
      <DataTrigger Binding="{Binding Icon}" Value="Rune"><Setter Property="Data" Value="{StaticResource Icon.Rune}"/></DataTrigger>
      <DataTrigger Binding="{Binding Icon}" Value="Ring"><Setter Property="Data" Value="{StaticResource Icon.Ring}"/></DataTrigger>
      <DataTrigger Binding="{Binding Icon}" Value="Tri"><Setter Property="Data" Value="{StaticResource Icon.Tri}"/></DataTrigger>
      <DataTrigger Binding="{Binding Icon}" Value="Slash"><Setter Property="Data" Value="{StaticResource Icon.Slash}"/></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Bare clickable surface: hit testing comes from the filled hex body only -->
  <Style x:Key="Style.NodeButton" TargetType="Button">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================================== -->
  <!-- Skill node                                                                             -->
  <!-- Every state has an enter storyboard that sets ALL layers, so any transition           -->
  <!-- (lock, reveal, acquire, refund, apply) animates from wherever the node currently is.  -->
  <!-- ===================================================================================== -->
  <DataTemplate x:Key="Template.SkillNode">
    <Grid Width="140" Height="140">
      <Grid.RenderTransform>
        <!-- Node box is centred on (X, Y) -->
        <TranslateTransform X="-70" Y="-70"/>
      </Grid.RenderTransform>

      <Button x:Name="Hit" Style="{StaticResource Style.NodeButton}" Command="{Binding Toggle}"
        RenderTransformOrigin="0.5,0.5">
        <Button.RenderTransform>
          <ScaleTransform/>
        </Button.RenderTransform>

        <Grid x:Name="Shaker">
        <Grid.RenderTransform>
          <TranslateTransform/>
        </Grid.RenderTransform>
        <Grid x:Name="Body" Width="140" Height="140" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform>
            <ScaleTransform/>
          </Grid.RenderTransform>

          <!-- Red ember behind locked nodes -->
          <!-- Glows are radial gradients, not BlurEffects: one offscreen pass per node exhausts
               Noesis' offscreen pool and shows up as blocky artifacts -->
          <Ellipse x:Name="RedGlow" Margin="-30" Fill="{StaticResource Brush.RedGlow}" Opacity="0" IsHitTestVisible="False"/>

          <!-- Gold glow behind acquired nodes; GlowHost pulses while the node is pending -->
          <Grid x:Name="GlowHost" IsHitTestVisible="False">
            <Ellipse x:Name="Glow" Margin="-34" Fill="{StaticResource Brush.GoldGlow}" Opacity="0"/>
          </Grid>

          <!-- Hover ring -->
          <Path x:Name="HoverRing" Data="{StaticResource Geo.HexHover}" Stroke="{StaticResource Brush.Gold}"
            StrokeThickness="1" Opacity="0" IsHitTestVisible="False"/>

          <!-- Hit surface + body -->
          <Path Data="{StaticResource Geo.HexBody}" Fill="{StaticResource Brush.Ink}"/>

          <!-- LOCKED: red frame -->
          <Grid x:Name="LockedLayer" Opacity="0" IsHitTestVisible="False">
            <Path Data="{StaticResource Geo.HexOuter}" Stroke="#FF5C1712" StrokeThickness="1.5"/>
            <Path Data="{StaticResource Geo.HexBody}" Stroke="{StaticResource Brush.Red}" StrokeThickness="1" Opacity="0.55"/>
          </Grid>

          <!-- AVAILABLE ("UNLOCKED" in the sheet): hairline gold frame with vertex ticks -->
          <Grid x:Name="AvailableLayer" Opacity="0" IsHitTestVisible="False">
            <Path Data="{StaticResource Geo.HexOuter}" Stroke="{StaticResource Brush.Gold}" StrokeThickness="1" Opacity="0.45"/>
            <Path Data="{StaticResource Geo.HexTicks}" Stroke="{StaticResource Brush.Gold}" StrokeThickness="1" Opacity="0.7"/>
            <Path Data="{StaticResource Geo.HexBody}" Stroke="{StaticResource Brush.Gold}" StrokeThickness="1" Opacity="0.25"/>
          </Grid>

          <!-- PENDING / OWNED ("SELECTED" in the sheet): thick gold border -->
          <Grid x:Name="OwnedLayer" Opacity="0" IsHitTestVisible="False">
            <Path Data="{StaticResource Geo.HexOuter}" Stroke="{StaticResource Brush.Gold}" StrokeThickness="4.5"/>
            <Path Data="{StaticResource Geo.HexInner}" Stroke="{StaticResource Brush.Gold}" StrokeThickness="1" Opacity="0.35"/>
          </Grid>

          <!-- Unlock FX: expanding rings + inner flash -->
          <Path x:Name="Burst" Data="{StaticResource Geo.HexOuter}" Stroke="{StaticResource Brush.Gold}"
            StrokeThickness="3" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
              <ScaleTransform/>
            </Path.RenderTransform>
          </Path>
          <Path x:Name="Burst2" Data="{StaticResource Geo.HexOuter}" Stroke="{StaticResource Brush.White}"
            StrokeThickness="1.5" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
              <ScaleTransform/>
            </Path.RenderTransform>
          </Path>
          <Path x:Name="Flash" Data="{StaticResource Geo.HexBody}" Fill="{StaticResource Brush.Gold}"
            Opacity="0" IsHitTestVisible="False"/>

          <!-- Glyph + name -->
          <Path x:Name="Icon" Style="{StaticResource Style.SkillIcon}" Width="28" Height="28"
            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" IsHitTestVisible="False">
            <Path.Fill>
              <SolidColorBrush Color="{StaticResource Color.Red}"/>
            </Path.Fill>
          </Path>
          <TextBlock x:Name="Label" Text="{Binding Name}" Width="86" Margin="0,76,0,0"
            VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
            FontFamily="{StaticResource Font.Main}" FontSize="12.5" LineHeight="12" LineStackingStrategy="BlockLineHeight"
            IsHitTestVisible="False">
            <TextBlock.Foreground>
              <SolidColorBrush Color="{StaticResource Color.Red}"/>
            </TextBlock.Foreground>
          </TextBlock>

          <!-- Denied feedback -->
          <Path x:Name="DenyRing" Data="{StaticResource Geo.HexOuter}" Stroke="{StaticResource Brush.Red}"
            StrokeThickness="3" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        </Grid>
      </Button>

      <!-- Tooltip (shown on hover, never hit-testable) -->
      <Canvas IsHitTestVisible="False">
        <Border x:Name="Tip" Canvas.Left="116" Canvas.Top="-34" Width="250" Opacity="0"
          Background="#F213141B" BorderBrush="{StaticResource Brush.Gold}" BorderThickness="1" Padding="12,10">
          <Border.RenderTransform>
            <TranslateTransform/>
          </Border.RenderTransform>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,2,12,0">
              <Path Style="{StaticResource Style.SkillIcon}" Width="22" Height="22" Fill="{StaticResource Brush.White}"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                <Path Data="{StaticResource Icon.Shard}" Fill="{StaticResource Brush.Gold}" Width="11" Height="13"
                  Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Cost}" Foreground="{StaticResource Brush.White}" FontSize="15"
                  FontFamily="{StaticResource Font.Main}" Margin="4,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Gold}" FontSize="14"
                FontFamily="{StaticResource Font.Main}"/>
              <TextBlock Text="{Binding Description}" Foreground="#FFE8E2DE" FontSize="13" TextWrapping="Wrap"
                FontFamily="{StaticResource Font.Main}" Margin="0,3,0,0"/>
              <TextBlock x:Name="Hint" Foreground="#FF9C8F8A" FontSize="11.5" FontStyle="Italic"
                FontFamily="{StaticResource Font.Main}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
      </Canvas>
    </Grid>

    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding TooltipOnLeft}" Value="True">
        <Setter TargetName="Tip" Property="Canvas.Left" Value="-226"/>
      </DataTrigger>

      <!-- Tooltip hints -->
      <DataTrigger Binding="{Binding State}" Value="Locked">
        <Setter TargetName="Hint" Property="Text" Value="Requires an acquired neighbouring skill."/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Available">
        <Setter TargetName="Hint" Property="Text" Value="Click to acquire."/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Pending">
        <Setter TargetName="Hint" Property="Text" Value="Click to refund. ENTER to apply."/>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Owned">
        <Setter TargetName="Hint" Property="Text" Value="Acquired."/>
      </DataTrigger>

      <!-- LOCKED: fade to red -->
      <DataTrigger Binding="{Binding State}" Value="Locked">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="LockedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
              <DoubleAnimation Storyboard.TargetName="AvailableLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
              <DoubleAnimation Storyboard.TargetName="OwnedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
              <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
              <DoubleAnimation Storyboard.TargetName="RedGlow" Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.35"/>
              <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(Path.Fill).(SolidColorBrush.Color)" To="{StaticResource Color.Red}" Duration="0:0:0.35"/>
              <ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="{StaticResource Color.Red}" Duration="0:0:0.35"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>

      <!-- AVAILABLE: reveal (red burns off, white ink, gold ring ripple) -->
      <DataTrigger Binding="{Binding State}" Value="Available">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="LockedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
              <DoubleAnimation Storyboard.TargetName="AvailableLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
              <DoubleAnimation Storyboard.TargetName="OwnedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="RedGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
              <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(Path.Fill).(SolidColorBrush.Color)" To="{StaticResource Color.White}" Duration="0:0:0.6"/>
              <ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#FFEDE6E2" Duration="0:0:0.6"/>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.35"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0">
                  <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimation Storyboard.TargetName="Burst" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:0.7"/>
              <DoubleAnimation Storyboard.TargetName="Burst" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.4" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Burst" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.4" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>

      <!-- PENDING: acquire (flash, double shockwave, elastic pop, then a breathing glow) -->
      <DataTrigger Binding="{Binding State}" Value="Pending">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="LockedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetName="AvailableLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetName="OwnedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetName="RedGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0.6">
                  <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(Path.Fill).(SolidColorBrush.Color)" To="{StaticResource Color.White}" Duration="0:0:0.2"/>
              <ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="{StaticResource Color.White}" Duration="0:0:0.2"/>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="0.85"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="0">
                  <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimation Storyboard.TargetName="Burst" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.9"/>
              <DoubleAnimation Storyboard.TargetName="Burst" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.9" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Burst" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.9" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Burst2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.12" From="0.9" To="0" Duration="0:0:0.7"/>
              <DoubleAnimation Storyboard.TargetName="Burst2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" BeginTime="0:0:0.12" From="1" To="1.5" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Burst2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" BeginTime="0:0:0.12" From="1" To="1.5" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1.25" To="1" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.25" To="1" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
          <BeginStoryboard x:Name="PendingPulse">
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetName="GlowHost" Storyboard.TargetProperty="Opacity" From="1" To="0.35" BeginTime="0:0:0.8" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="PendingPulse"/>
        </DataTrigger.ExitActions>
      </DataTrigger>

      <!-- OWNED: seal (steady glow, short flash) -->
      <DataTrigger Binding="{Binding State}" Value="Owned">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="LockedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="AvailableLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="OwnedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="RedGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.6"/>
              <ColorAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(Path.Fill).(SolidColorBrush.Color)" To="{StaticResource Color.White}" Duration="0:0:0.3"/>
              <ColorAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="{StaticResource Color.White}" Duration="0:0:0.3"/>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="0">
                  <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimation Storyboard.TargetName="Burst2" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:0.5"/>
              <DoubleAnimation Storyboard.TargetName="Burst2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1.25" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Burst2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.25" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>

      <!-- DENIED (locked or not enough shards): shake + red flash. The pulse alternates A/B
           so the trigger fires on every denial. -->
      <DataTrigger Binding="{Binding DenyPulse}" Value="A">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shaker" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="-6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.20" Value="6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DenyRing" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.75" Value="0">
                  <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding DenyPulse}" Value="B">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Shaker" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="-6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.20" Value="6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DenyRing" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.75" Value="0">
                  <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>

      <!-- HOVER -->
      <DataTrigger Binding="{Binding IsMouseOver, ElementName=Hit}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15"/>
              <DoubleAnimation Storyboard.TargetName="Hit" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.15"/>
              <DoubleAnimation Storyboard.TargetName="Hit" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.15"/>
              <DoubleAnimation Storyboard.TargetName="Tip" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15"/>
              <DoubleAnimation Storyboard.TargetName="Tip" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" BeginTime="0:0:0.1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetName="Hit" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetName="Hit" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetName="Tip" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.ExitActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Nodes are positioned on a Canvas by their lattice coordinates; hovered node goes on top -->
  <Style x:Key="Style.NodeContainer" TargetType="ContentPresenter">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Panel.ZIndex" Value="10"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===================================================================================== -->
  <!-- Link between two nodes                                                                 -->
  <!-- ===================================================================================== -->
  <DataTemplate x:Key="Template.SkillLink">
    <Canvas>
      <Line x:Name="Glow" X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
        Stroke="{StaticResource Brush.Gold}" StrokeThickness="7" Opacity="0"/>
      <Line x:Name="Wire" X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" StrokeThickness="1.5">
        <Line.Stroke>
          <SolidColorBrush Color="#FF6E1913"/>
        </Line.Stroke>
      </Line>
      <!-- Energy that travels along the link when it becomes active (dash = whole length) -->
      <Line x:Name="Flow" X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
        Stroke="{StaticResource Brush.Gold}" StrokeThickness="2.5" StrokeDashArray="100 100" StrokeDashOffset="100"
        Opacity="0"/>
    </Canvas>

    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding State}" Value="Locked">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="Wire" Storyboard.TargetProperty="(Line.Stroke).(SolidColorBrush.Color)" To="#FF6E1913" Duration="0:0:0.4"/>
              <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Open">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimation Storyboard.TargetName="Wire" Storyboard.TargetProperty="(Line.Stroke).(SolidColorBrush.Color)" To="#FF6A5D59" Duration="0:0:0.5"/>
              <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Active">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Flow" Storyboard.TargetProperty="StrokeDashOffset" From="100" To="0" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flow" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
              </DoubleAnimationUsingKeyFrames>
              <ColorAnimation Storyboard.TargetName="Wire" Storyboard.TargetProperty="(Line.Stroke).(SolidColorBrush.Color)" To="#FFE9D2B0" BeginTime="0:0:0.3" Duration="0:0:0.4"/>
              <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.12" BeginTime="0:0:0.3" Duration="0:0:0.5"/>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ===================================================================================== -->
  <!-- Mind shards counter (DataContext = ViewModel)                                          -->
  <!-- ===================================================================================== -->
  <DataTemplate x:Key="Template.Shards">
    <Grid x:Name="Counter" Width="76" Height="84" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform/>
      </Grid.RenderTransform>
      <Ellipse Margin="-26" Fill="{StaticResource Brush.GoldGlow}" Opacity="0.25"/>
      <Path x:Name="Frame" Data="M38,2 L74,22 L74,62 L38,82 L2,62 L2,22 Z" Fill="{StaticResource Brush.Ink}" StrokeThickness="1.5">
        <Path.Stroke>
          <SolidColorBrush Color="{StaticResource Color.Gold}"/>
        </Path.Stroke>
      </Path>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Path Data="{StaticResource Icon.Shard}" Fill="{StaticResource Brush.Gold}" Width="16" Height="20"
          Stretch="Uniform" VerticalAlignment="Center"/>
        <TextBlock x:Name="Count" Text="{Binding Shards}" FontFamily="{StaticResource Font.Main}" FontSize="32"
          Margin="6,0,0,4" VerticalAlignment="Center">
          <TextBlock.Foreground>
            <SolidColorBrush Color="{StaticResource Color.White}"/>
          </TextBlock.Foreground>
        </TextBlock>
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding ShardsDenyPulse}" Value="A">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#FFD6281C"/>
                <LinearColorKeyFrame KeyTime="0:0:0.6" Value="#FFFFC582"/>
              </ColorAnimationUsingKeyFrames>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="Count" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#FFD6281C"/>
                <LinearColorKeyFrame KeyTime="0:0:0.6" Value="#FFFFFFFF"/>
              </ColorAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Counter" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1">
                  <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Counter" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1">
                  <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding ShardsDenyPulse}" Value="B">
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#FFD6281C"/>
                <LinearColorKeyFrame KeyTime="0:0:0.6" Value="#FFFFC582"/>
              </ColorAnimationUsingKeyFrames>
              <ColorAnimationUsingKeyFrames Storyboard.TargetName="Count" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#FFD6281C"/>
                <LinearColorKeyFrame KeyTime="0:0:0.6" Value="#FFFFFFFF"/>
              </ColorAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Counter" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1">
                  <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Counter" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.15"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1">
                  <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ===================================================================================== -->
  <!-- ESC / ENTER hotkey buttons (triple hex outline)                                        -->
  <!-- ===================================================================================== -->
  <Style x:Key="Style.HotkeyButton" TargetType="Button">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Width" Value="96"/>
    <Setter Property="Height" Value="96"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform">
      <Setter.Value>
        <ScaleTransform/>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Glow" Margin="-24" Fill="{StaticResource Brush.GoldGlow}" Opacity="0"/>
            <Path Data="M48,6 L84.4,27 L84.4,69 L48,90 L11.6,69 L11.6,27 Z" Fill="{StaticResource Brush.Ink}"
              Stroke="{StaticResource Brush.Gold}" StrokeThickness="1.2"/>
            <Path Data="M48,11 L80.0,29.5 L80.0,66.5 L48,85 L16.0,66.5 L16.0,29.5 Z"
              Stroke="{StaticResource Brush.Gold}" StrokeThickness="1" Opacity="0.75"/>
            <Path Data="M48,16 L75.7,32 L75.7,64 L48,80 L20.3,64 L20.3,32 Z"
              Stroke="{StaticResource Brush.Gold}" StrokeThickness="1" Opacity="0.5"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.15"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Style.HotkeyKey" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Red}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="Style.HotkeyAction" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.White}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

</ResourceDictionary>
